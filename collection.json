          ]
        },
        {
          "name": "DELETE booking - no auth (403)",
          "request": {
            "method": "DELETE",
            "description": "Given this run's booking and no authentication, When DELETE is attempted, Then 403 is returned and GET verifies the booking is unchanged.",
            "header": [],
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then delete without auth returns 403\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Then run booking remains after rejected deletion\", function (done) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"Url\") + \"/booking/\" + pm.environment.get(\"booking_id\"),",
                  "        method: 'GET'",
                  "    }, function (err, res) {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(200);",
                  "        pm.expect(res.json()).to.eql(JSON.parse(pm.environment.get(\"expected_booking\")));",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT booking - invalid token (403)",
          "request": {
            "method": "PUT",
            "description": "Given this run's booking and an invalid token, When PUT is attempted, Then 403 is returned and GET verifies the booking is unchanged.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token=invalid-token-123",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Omar\",\n    \"lastname\": \"Peralta\",\n    \"totalprice\": 1500,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-05\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
