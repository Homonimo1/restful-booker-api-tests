                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE booking (authenticated)",
          "request": {
            "method": "DELETE",
            "description": "Given this run's owned booking and token, When authenticated DELETE is sent, Then status is 201 and GET confirms it is absent.",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Cookie", "value": "token={{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then delete returns 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Then deleted run booking GET returns 404\", function (done) { pm.sendRequest({url: pm.environment.get(\"Url\") + \"/booking/\" + pm.environment.get(\"booking_id\"), method: \"GET\"}, function (err, res) { pm.expect(err).to.be.null; pm.expect(res.code).to.eql(404); done(); }); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT booking - non-existent ID (405)",
          "request": {
            "method": "PUT",
            "description": "Given this run's booking has been deleted, When authenticated PUT targets that ID, Then the historical response is characterized as 405.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Omar\",\n    \"lastname\": \"Peralta\",\n    \"totalprice\": 1500,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-05\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then PUT on deleted run ID returns historically observed 405\", function () {",
                  "    pm.response.to.have.status(405);",
                  "});",
                  "console.log(\"Historical PUT-on-deleted-ID response:\", pm.response.code, pm.response.text());"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Teardown",
      "description": "Post-run checks: leaves the sandbox clean and clears the runtime variables.",
      "item": [
        {
          "name": "TEARDOWN cleanup booking",
          "request": {
            "method": "GET",
            "description": "Given this run's booking ID and token, When teardown GET checks it, Then 404 confirms absence or 200 triggers an owned-booking DELETE. Runtime values are cleared.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then teardown leaves no run-owned booking behind\", function (done) {",
                  "    if (pm.response.code !== 200) {",
                  "        pm.expect(pm.response.code).to.eql(404);",
                  "        return done();",
                  "    }",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"Url\") + \"/booking/\" + pm.environment.get(\"booking_id\"),",
                  "        method: \"DELETE\",",
                  "        header: { Cookie: \"token=\" + pm.environment.get(\"token\") }",
                  "    }, function (err, res) {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(201);",
                  "        done();",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Cleanup: runtime variables cleared\", function () {",
                  "    pm.environment.unset(\"token\");",
                  "    pm.environment.unset(\"booking_id\");",
                  "    pm.environment.unset(\"run_firstname\");",
                  "    pm.environment.unset(\"expected_booking\");",
                  "    pm.expect(pm.environment.get(\"booking_id\")).to.eql(undefined);",
                  "    pm.expect(pm.environment.get(\"run_firstname\")).to.eql(undefined);",
                  "    pm.expect(pm.environment.get(\"expected_booking\")).to.eql(undefined);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
