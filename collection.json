{
  "info": {
    "_postman_id": "7bdb8b66-6665-4bb0-9b39-0b299b31e5fd",
    "name": "Restful Booker - QA Suite",
    "description": "End-to-end online API regression suite for the public Restful Booker API. Run requests in order: a unique booking and token are created at runtime; negative authorization checks and cleanup target only that booking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "AUTH",
      "description": "Authentication. Obtains the token used by the write operations.",
      "item": [
        {
          "name": "POST token auth",
          "request": {
            "method": "POST",
            "description": "Given the sandbox credentials, When POST /auth is sent, Then a token is stored for this run.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/auth",
              "host": ["{{Url}}"],
              "path": ["auth"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"response contains token\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"token\");",
                  "",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST token auth - bad credentials",
          "request": {
            "method": "POST",
            "description": "Given an incorrect password, When POST /auth is sent, Then the historical response is 200 with Bad credentials and no token.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/auth",
              "host": ["{{Url}}"],
              "path": ["auth"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 (this API does not use 401)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response reports bad credentials\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"reason\", \"Bad credentials\");",
                  "});",
                  "pm.test(\"No token is returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.not.have.property(\"token\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Booking - CRUD",
      "description": "Booking lifecycle setup and read/update checks. Run-owned negative authorization checks and deletion follow in the Negative cases folder.",
      "item": [
        {
          "name": "GET all booking IDs",
          "request": {
            "method": "GET",
            "description": "Given the shared sandbox, When booking IDs are listed, Then a non-empty array is returned.",
            "header": [],
            "url": {
              "raw": "{{Url}}/booking",
              "host": ["{{Url}}"],
              "path": ["booking"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Response is an array\", function () {",
                  "   var jsonData = pm.response.json();",
                  "   pm.expect(jsonData).to.be.an(\"array\")",
                  "",
                  "});",
                  "",
                  "pm.test(\"Array is not empty\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST create booking",
          "request": {
            "method": "POST",
            "description": "Given a unique synthetic run name, When a booking is created, Then its fields match the submitted payload and its ID is retained for this run.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{run_firstname}}\",\n    \"lastname\": \"Synthetic\",\n    \"totalprice\": 1500,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-05\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking",
              "host": ["{{Url}}"],
              "path": ["booking"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Then created fields match submitted payload\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.booking).to.eql(JSON.parse(pm.environment.get(\"expected_booking\")));",
                  "});",
                  "",
                  "pm.test(\"Response matches schema\", function () {",
                  "    const schema = {",
                  "        \"type\": \"object\",",
                  "        \"properties\": {",
                  "            \"bookingid\": { \"type\": \"number\" },",
                  "            \"booking\": {",
                  "                \"type\": \"object\",",
                  "                \"properties\": {",
                  "                    \"firstname\": { \"type\": \"string\" },",
                  "                    \"lastname\": { \"type\": \"string\" },",
                  "                    \"totalprice\": { \"type\": \"number\" },",
                  "                    \"depositpaid\": { \"type\": \"boolean\" },",
                  "                    \"bookingdates\": {",
                  "                        \"type\": \"object\",",
                  "                        \"properties\": {",
                  "                            \"checkin\": { \"type\": \"string\" },",
                  "                            \"checkout\": { \"type\": \"string\" }",
                  "                        },",
                  "                        \"required\": [\"checkin\", \"checkout\"]",
                  "                    },",
                  "                    \"additionalneeds\": { \"type\": \"string\" }",
                  "                },",
                  "                \"required\": [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"]",
                  "            }",
                  "        },",
                  "        \"required\": [\"bookingid\", \"booking\"]",
                  "    };",
                  "    pm.expect(pm.response.json()).to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"Then booking ID is available for this run\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"bookingid\");",
                  "",
                  "    const booking_id = jsonData.bookingid;",
                  "    pm.environment.set(\"booking_id\", booking_id);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('run_firstname', 'QA-' + pm.variables.replaceIn('{{$guid}}'));",
                  "pm.environment.set('expected_booking', pm.variables.replaceIn(pm.request.body.raw));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET booking by ID",
          "request": {
            "method": "GET",
            "description": "Given this run's booking ID, When GET reads the booking, Then all fields match the creation payload.",
            "header": [],
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Firstname and lastname are present\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.eql(JSON.parse(pm.environment.get(\"expected_booking\")));",
                  "     });"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT update booking",
          "request": {
            "method": "PUT",
            "description": "Given this run's booking and token, When PUT replaces its fields, Then the response matches the submitted payload.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{run_firstname}}\",\n    \"lastname\": \"Suit Validada\",\n    \"totalprice\": 2000,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-11-01\",\n        \"checkout\": \"2026-11-05\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Then PUT returns every submitted field\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.eql(JSON.parse(pm.environment.get(\"expected_booking\")));",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('expected_booking', pm.variables.replaceIn(pm.request.body.raw));"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH partial update",
          "request": {
            "method": "PATCH",
            "description": "Given the PUT payload, When PATCH changes totalprice, Then omitted fields remain unchanged.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"totalprice\": 300\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Then PATCH changes price and preserves omitted fields\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    const expected = JSON.parse(pm.environment.get(\"expected_booking\"));",
                  "    expected.totalprice = 300;",
                  "    pm.expect(jsonData).to.eql(expected);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const previous = JSON.parse(pm.environment.get('expected_booking'));",
                  "const patch = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
                  "pm.environment.set('expected_booking', JSON.stringify({ ...previous, ...patch }));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET verify update persisted",
          "request": {
            "method": "GET",
            "description": "Given PUT and PATCH updated this run's booking, When GET reads it again, Then the final merged payload is persisted.",
            "header": [],
            "url": {
              "raw": "{{Url}}/booking/{{booking_id}}",
              "host": ["{{Url}}"],
              "path": ["booking", "{{booking_id}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Then PUT and PATCH fields persisted\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    const expected = JSON.parse(pm.environment.get(\"expected_booking\"));",
                  "    pm.expect(jsonData).to.eql(expected);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Filters",
      "description": "Query filters exposed by the booking search endpoint.",
      "item": [
        {
          "name": "GET bookings by firstname",
          "request": {
            "method": "GET",
            "description": "Given this run's unique firstname and booking ID, When filtering by that firstname, Then the results include this run's created booking; an unknown name returns an empty array.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{Url}}/booking?firstname={{run_firstname}}",
              "host": ["{{Url}}"],
              "path": ["booking"],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{run_firstname}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of booking IDs\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "    pm.expect(jsonData.some(item => item.bookingid === Number(pm.environment.get(\"booking_id\")))).to.eql(true);",
                  "    jsonData.forEach(function (item) {",
                  "        pm.expect(item).to.have.property(\"bookingid\");",
                  "    });",
                  "});",
                  "pm.test(\"Unknown firstname returns an empty array\", function (done) {",
                  "    pm.sendRequest({",
                  "        url: pm.environment.get(\"Url\") + \"/booking?firstname=NoSuchName12345\",",
                  "        method: \"GET\"",
                  "    }, function (err, res) {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res.code).to.eql(200);",
                  "        pm.expect(res.json()).to.be.an(\"array\");",
                  "        pm.expect(res.json().length).to.eql(0);",
                  "        done();",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Negative cases",
      "description": "Error handling and edge cases.",
      "item": [
        {
          "name": "POST create booking - missing fields",
          "request": {
            "method": "POST",
            "description": "Given a payload missing firstname, When booking creation is attempted, Then this collection records the previously observed 500 without asserting a contract defect.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"lastname\": \"Peralta\",\n    \"totalprice\": 1500,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-07-28\",\n        \"checkout\": \"2017-12-31\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{Url}}/booking",
              "host": ["{{Url}}"],
              "path": ["booking"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Then missing firstname returns historically observed status 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});",
                  "console.log(\"Historical missing-firstname response:\", pm.response.code, pm.response.text(), pm.response.responseTime + \"ms\");"
                ]
              }
            }
          ]
        },
